{{ if eq .chezmoi.os "darwin" }}
.config/Code/
{{ end }}
{{ if eq .chezmoi.os "linux" }}
Library/
# Omarchy owns these on Linux; the repo copies exist only so macOS (no Omarchy)
# still gets a working theme setup. Letting chezmoi apply them on Linux rolls the
# omarchy-nvim package's files backwards -- see /usr/share/omarchy-nvim/config/.
.config/nvim/lua/plugins/theme.lua
.config/nvim/lua/plugins/all-themes.lua
.config/nvim/lua/plugins/omarchy-theme-hotreload.lua
# Follows from the above: Omarchy and this repo declare different theme plugins,
# so the lockfile can't be identical on both OSes. Each Linux box keeps its own;
# the tracked copy stays pinned for macOS.
.config/nvim/lazy-lock.json
{{ end }}
